<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ profile.name }}</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: {{ theme.font_family }};
      background: {{ theme.background }};
      min-height: 100vh;
      padding: 2rem 1rem 4rem;
    }

    .site-wrapper {
      max-width: 640px;
      margin: 0 auto;
    }

    /* Profile header */
    .profile {
      display: flex;
      align-items: center;
      gap: 1rem;
      margin-bottom: 2rem;
    }
    .profile-avatar {
      width: 64px;
      height: 64px;
      border-radius: 50%;
      object-fit: cover;
      flex-shrink: 0;
    }
    .profile-avatar-placeholder {
      width: 64px;
      height: 64px;
      border-radius: 50%;
      background: {{ theme.accent }};
      flex-shrink: 0;
    }
    .profile-name {
      font-size: 1.25rem;
      font-weight: 700;
      color: #111;
    }
    .profile-bio {
      font-size: 0.875rem;
      color: #555;
      margin-top: 0.25rem;
    }

    /* Grid */
    .grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 12px;
    }

    @media (max-width: 540px) {
      .grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    /* Grid size helpers */
    .col-1 { grid-column: span 1; }
    .col-2 { grid-column: span 2; }
    .row-1 { grid-row: span 1; }
    .row-2 { grid-row: span 2; }

    /* Card base */
    .card {
      border-radius: {{ theme.border_radius }}px;
      overflow: hidden;
      position: relative;
      {% if theme.card_shadow %}
      box-shadow: 0 2px 8px rgba(0,0,0,0.08);
      {% endif %}
      aspect-ratio: 1 / 1;
    }
    .card.row-2 { aspect-ratio: 1 / 2; }
    .card.col-2.row-1 { aspect-ratio: 2 / 1; }
    .card.col-2.row-2 { aspect-ratio: 1 / 1; }

    /* Spacer */
    .card-spacer {
      background: transparent;
      box-shadow: none !important;
    }

    /* Link card */
    .card-link {
      display: block;
      text-decoration: none;
      background: {{ theme.card_background }};
    }
    .card-link:hover { opacity: 0.88; transition: opacity 0.15s; }
    .card-link-image {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }
    .card-link-overlay {
      position: absolute;
      bottom: 0; left: 0; right: 0;
      padding: 0.75rem;
      background: linear-gradient(transparent, rgba(0,0,0,0.55));
    }
    .card-link-title {
      color: #fff;
      font-size: 0.875rem;
      font-weight: 600;
      line-height: 1.3;
    }
    .card-link-no-image {
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: flex-start;
      padding: 1.25rem;
      height: 100%;
    }
    .card-link-no-image .card-link-title {
      color: #111;
      font-size: 0.9375rem;
    }
    .card-link-url {
      font-size: 0.75rem;
      color: #888;
      margin-top: 0.25rem;
      word-break: break-all;
    }

    /* Text card */
    .card-text {
      background: {{ theme.card_background }};
      display: flex;
      align-items: center;
      padding: 1.25rem;
    }
    .card-text-content {
      font-size: 0.9375rem;
      color: #222;
      line-height: 1.6;
      white-space: pre-wrap;
    }

    /* Social card */
    .card-social {
      background: {{ theme.card_background }};
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      padding: 1rem;
      text-decoration: none;
    }
    .card-social:hover { opacity: 0.88; transition: opacity 0.15s; }
    .social-avatar {
      width: 48px;
      height: 48px;
      border-radius: 50%;
      object-fit: cover;
      margin-bottom: 0.5rem;
    }
    .social-display-name {
      font-size: 0.9375rem;
      font-weight: 700;
      color: #111;
    }
    .social-username {
      font-size: 0.75rem;
      color: #888;
      margin-top: 0.125rem;
    }
    .social-bio {
      font-size: 0.75rem;
      color: #555;
      margin-top: 0.375rem;
      line-height: 1.4;
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .social-platform-badge {
      position: absolute;
      top: 0.75rem;
      right: 0.75rem;
      width: 20px;
      height: 20px;
      opacity: 0.4;
    }
  </style>
</head>
<body>
  <div class="site-wrapper">

    <div class="profile">
      {% if profile.avatar %}
      <img class="profile-avatar" src="{{ profile.avatar }}" alt="{{ profile.name }}">
      {% else %}
      <div class="profile-avatar-placeholder"></div>
      {% endif %}
      <div>
        <div class="profile-name">{{ profile.name }}</div>
        {% if profile.bio %}
        <div class="profile-bio">{{ profile.bio }}</div>
        {% endif %}
      </div>
    </div>

    <div class="grid">
      {% for block in rendered_blocks %}
      {% set w, h = block.size.split('x') %}
      {% if block.type == 'spacer' %}
      <div class="card card-spacer col-{{ w }} row-{{ h }}"></div>

      {% elif block.type == 'text' %}
      <div class="card card-text col-{{ w }} row-{{ h }}"
           style="background: {{ block.color or theme.card_background }}">
        <div class="card-text-content">{{ block.content }}</div>
      </div>

      {% elif block.type == 'link' %}
      <a class="card card-link col-{{ w }} row-{{ h }}"
         href="{{ block.url }}" target="_blank" rel="noopener"
         style="background: {{ block.color or theme.card_background }}">
        {% if block.resolved_image %}
        <img class="card-link-image" src="{{ block.resolved_image }}" alt="{{ block.title }}">
        <div class="card-link-overlay">
          <div class="card-link-title">{{ block.title }}</div>
        </div>
        {% else %}
        <div class="card-link-no-image">
          <div class="card-link-title">{{ block.title }}</div>
          <div class="card-link-url">{{ block.url }}</div>
        </div>
        {% endif %}
      </a>

      {% elif block.type == 'social' %}
      <a class="card card-social col-{{ w }} row-{{ h }}"
         href="{{ block.profile.profile_url }}" target="_blank" rel="noopener"
         style="background: {{ block.color or theme.card_background }}">
        {{ platform_icon(block.platform) }}
        {% if block.profile.avatar_url %}
        <img class="social-avatar" src="{{ block.profile.avatar_url }}" alt="{{ block.profile.display_name }}">
        {% endif %}
        <div class="social-display-name">{{ block.profile.display_name }}</div>
        <div class="social-username">@{{ block.profile.username }}</div>
        {% if block.profile.bio %}
        <div class="social-bio">{{ block.profile.bio }}</div>
        {% endif %}
      </a>
      {% endif %}
      {% endfor %}
    </div>

  </div>
</body>
</html>
